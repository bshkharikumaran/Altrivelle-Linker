# ==============================================================================
# FileLink — Environment Configuration
# Developed by ALTRIVELLE TECHNOLOGIES
# ==============================================================================

# Client-Side Supabase Configuration (Exposed to browser via Vite)
# Get these from your Supabase project dashboard -> Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Client Application Settings
VITE_APP_NAME=FileLink
VITE_COMPANY_NAME="ALTRIVELLE TECHNOLOGIES"
VITE_MAX_UPLOAD_SIZE_MB=25
VITE_DEFAULT_STORAGE_QUOTA_MB=100

# Server-Side Configuration (Vercel Serverless Functions Only)
# IMPORTANT: NEVER prefix with VITE_ and NEVER commit actual keys to Git!
# Add these in Vercel Dashboard -> Project Settings -> Environment Variables
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
